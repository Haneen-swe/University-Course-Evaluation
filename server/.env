# ─────────────────────────────────────────────────────────────
#  University Course Evaluation System — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Application ────────────────────────────────────────────
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001

# ── Database (PostgreSQL) ───────────────────────────────────
DATABASE_URL=postgresql://postgres:123456@localhost:5432/uces
# For Docker Compose use:
# DATABASE_URL=postgresql://uces_app:changeme@postgres:5432/uces

# ── Cache / Queue (Redis) ───────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
# For Docker Compose with password:
# REDIS_URL=redis://:changeme@redis:6379
# REDIS_PASSWORD=changeme

# ── JWT Secrets ─────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_char_random_hex_string
JWT_REFRESH_SECRET=replace_with_different_64_char_random_hex_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Docker Database Credentials ─────────────────────────────
DB_PASSWORD=changeme
DB_USER=uces_app
DB_NAME=uces

# ── Email (SMTP) ─────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=uces@example.com
SMTP_PASS=smtp_password_here
EMAIL_FROM="UCES No-Reply <uces@example.com>"

# ── Client ───────────────────────────────────────────────────
CLIENT_URL=http://localhost:5174
VITE_API_URL=http://localhost:3001

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info

# ── Feature Flags ────────────────────────────────────────────
ENABLE_SWAGGER=true
ENABLE_SEED=true
